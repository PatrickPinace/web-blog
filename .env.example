# Skopiuj do .env i uzupełnij. Plik .env NIE trafia do repo.

# --- Flask ---
FLASK_APP=wsgi.py
FLASK_ENV=development

# Klucz sesji. Wygeneruj własny:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=zmien-mnie-na-losowy-ciag-min-32-bajty

# --- Baza danych ---
# Lokalnie: Postgres w Dockerze (patrz README).
# Produkcja: connection string z Neona.
# Uwaga: sterownik psycopg3 wymaga prefiksu postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://blog:blog@localhost:5432/blog

# --- Cloudinary (upload obrazków) ---
# Dwa równoważne warianty konfiguracji — użyj JEDNEGO z nich.
#
# Wariant A (zalecany): jeden URL z panelu Cloudinary → Dashboard
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
#
# Wariant B: trzy osobne zmienne (odkomentuj i usuń CLOUDINARY_URL powyżej)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Limity uploadu ---
MAX_UPLOAD_MB=5

# Domeny, z których wolno wstawić obrazek przez URL (rozdzielone przecinkami).
# Serwer nigdy nie pobiera tych zasobów — adres trafia wprost do <img src>.
ALLOWED_IMAGE_HOSTS=res.cloudinary.com

# --- Dane bloga (branding — patrz README, sekcja "Fork") ---
BLOG_TITLE=Nazwa bloga
BLOG_DESCRIPTION=Autorski blog o projektowaniu, programowaniu i rozwijaniu serwisu.
BLOG_AUTHOR=Imię Nazwisko
BLOG_BASE_URL=http://localhost:5000

# Data w stopce ("Serwis działa od..."). Puste = wiersz się nie renderuje.
# Ustawiana ręcznie — bez hostingu z realnym uptime nie ma czego monitorować
# automatycznie. Format: DD.MM.RRRR.
BLOG_LIVE_SINCE=

# --- Linki w stopce ---
# Puste = ikona się nie renderuje (patrz base.html) — nie ustawiaj bez
# prawdziwego profilu, żeby nie zostawić martwego linku.
BLOG_EMAIL=
BLOG_GITHUB_URL=
BLOG_REPOSITORY_URL=
BLOG_PORTFOLIO_URL=

# --- Seria „Jak powstaje ten blog” ---
# Uporządkowana, ręcznie utrzymywana lista slugów. Kolejność tutaj jest
# kolejnością części na /about i w nawigacji artykułów; szkice, kosz i wpisy
# zaplanowane na przyszłość są automatycznie pomijane.
BLOG_BUILD_SERIES_SLUGS=
